; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Progetto Completo"
run/main_scene="uid://dr3uouvv5aiu3"
config/features=PackedStringArray("4.6", "Forward Plus")
run/max_fps=120
config/icon="res://icon.svg"

[display]

window/size/viewport_width=432
window/size/viewport_height=240
window/size/window_width_override=1296
window/size/window_height_override=720
window/stretch/mode="viewport"

[layer_names]

2d_physics/layer_1="Player"
2d_physics/layer_2="Moving Platforms"
2d_physics/layer_3="Pickups"
2d_physics/layer_4="Tiles"
2d_physics/layer_5="Killzone"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
